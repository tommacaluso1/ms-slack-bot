    {
      "parameters": {
        "jsCode": "const input = $json;\nif (!input.ticket_id) {\n  throw new Error('ticket_id is required');\n}\nreturn [{ json: { ticket_id: Number(input.ticket_id), updated_at: input.updated_at || '', webhook_payload: input } }];"
      },
      "id": "Validate Input",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        840
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = getWorkflowStaticData('global');\nif (!data.seen) data.seen = {};\nconst now = Date.now();\nconst ttlMs = 1000 * 60 * 60 * 24 * 60;\nfor (const [k, v] of Object.entries(data.seen)) {\n  if (!v?.t || now - v.t > ttlMs) delete data.seen[k];\n}\nconst key = `${$json.ticket_id}:${$json.updated_at || 'na'}`;\nif (data.seen[key]) return [];\ndata.seen[key] = { t: now };\nreturn [{ json: { ...$json, _dedupe_key: key } }];"
      },
      "id": "Deduplicate Webhook",
      "name": "Deduplicate Webhook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        840
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{`https://${$env.FRESHDESK_DOMAIN}.freshdesk.com/api/v2/tickets/${$json.ticket_id}?include=conversations`}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Basic ' + Buffer.from(($env.FRESHDESK_API_KEY || '') + ':X').toString('base64') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "Get Ticket",
      "name": "Get Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        840
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const t = $json;\nif (!t.id) throw new Error('Freshdesk ticket fetch failed');\nconst conv = Array.isArray(t.conversations) ? t.conversations : [];\nconst agentMessages = conv.filter(c => c.user_id && (c.body_text || c.body));\nconst last = agentMessages[agentMessages.length - 1] || {};\nconst resolution = (last.body_text || last.body || '').replace(/<[^>]+>/g, ' ');\nconst src = `${t.subject || ''}\n\n${(t.description_text || t.description || '').replace(/<[^>]+>/g, ' ')}\n\nResolution:\n${resolution}`;\nreturn [{ json: { ticket: t, kb_source_text: src } }];"
      },
      "id": "Extract Ticket Content",
      "name": "Extract Ticket Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        840
      ]
    },
    {
      "parameters": {
        "jsCode": "let text = $json.kb_source_text || '';\ntext = text.replace(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/gi, '[REDACTED_EMAIL]');\ntext = text.replace(/(?<!\\d)(?:\\+?\\d[\\d\\s().-]{7,}\\d)/g, '[REDACTED_PHONE]');\ntext = text.replace(/\\b\\d{1,5}\\s+[A-Za-z0-9.\\s]{2,}\\s(?:Street|St|Avenue|Ave|Road|Rd|Lane|Ln|Drive|Dr|Boulevard|Blvd)\\b/gi, '[REDACTED_ADDRESS]');\ntext = text.replace(/\\b([A-Z][a-z]+\\s+[A-Z][a-z]+)\\b/g, '[REDACTED_NAME]');\nreturn [{ json: { ...$json, redacted_text: text } }];"
      },
      "id": "Redact PII",
      "name": "Redact PII",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        840
      ]
    },
    {
      "parameters": {
        "jsCode": "const txt = $json.redacted_text || '';\nconst subj = ($json.ticket.subject || 'Untitled').replace(/\\s+/g, ' ').trim();\nconst confidence = txt.length > 100 ? 0.82 : 0.55;\nconst steps = [];\nif (/password|login|access/i.test(txt)) {\n  steps.push('Verify account status and reset credentials if needed.');\n  steps.push('Clear cached credentials and retry sign in.');\n}\nif (/error|failed|exception|timeout/i.test(txt)) {\n  steps.push('Capture exact error and timestamp from logs.');\n  steps.push('Apply known fix or rollback recent change.');\n}\nif (!steps.length) steps.push('Review ticket history and apply documented troubleshooting steps.');\n\nconst kb = {\n  should_create_kb: confidence >= Number($env.KB_MIN_CONFIDENCE || 0.75),\n  confidence,\n  kb_title: `How to resolve: ${subj}`.slice(0, 200),\n  kb_problem: txt.slice(0, 400),\n  kb_environment: 'Freshdesk / Slack intake',\n  kb_steps: steps,\n  kb_resolution: 'Issue resolved using validated support workflow and corrective actions.',\n  kb_keywords: Array.from(new Set([...(($json.ticket.tags)||[]), 'support', 'resolved'])).slice(0, 10),\n  kb_folder_name: ($json.ticket.type || 'General').toString().slice(0, 60),\n  kb_article_tags: Array.from(new Set([...(($json.ticket.tags)||[]), 'draft', 'internal'])).slice(0, 15)\n};\nreturn [{ json: { ...$json, kb } }];"
      },
      "id": "Draft KB JSON",
      "name": "Draft KB JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
