          "jsCode": "const base = $item(0).$node['Normalize Folder'].json;\nconst res = $json.results || $json;\nconst items = Array.isArray(res) ? res : [];\nconst title = (base.kb.kb_title || '').toLowerCase();\nlet best = null;\nlet bestScore = 0;\nfor (const a of items) {\n  const t = (a.title || '').toLowerCase();\n  const overlap = t.split(' ').filter(w => title.includes(w)).length;\n  const score = title ? overlap / Math.max(title.split(' ').length, 1) : 0;\n  if (score > bestScore) { best = a; bestScore = score; }\n}\nreturn [{ json: { ...base, matched_article_id: bestScore >= 0.6 ? best?.id : null } }];"
