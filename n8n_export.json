        "parameters": {
          "jsCode": "const data = getWorkflowStaticData('global');\nconst now = Date.now();\nconst ttlMs = 1000 * 60 * 60 * 24 * 7;\nif (!data.seen) data.seen = {};\nfor (const [k, v] of Object.entries(data.seen)) {\n  if (!v || (now - v) > ttlMs) delete data.seen[k];\n}\n\nconst e = $json;\nconst channel = e.event?.channel || e.channel || '';\nconst ts = e.event?.ts || e.ts || '';\nconst eventId = e.event_id || `${channel}:${ts}`;\nconst subtype = e.event?.subtype || '';\nconst hasBotId = !!(e.event?.bot_id || e.bot_id);\nconst userId = e.event?.user || e.user || '';\nconst ignoreUsers = String($env.SLACK_IGNORE_USER_IDS || '').split(',').map(s => s.trim()).filter(Boolean);\nconst ignoreThreadReplies = String($env.SLACK_IGNORE_THREAD_REPLIES || 'true').toLowerCase() === 'true';\nconst isThreadReply = !!(e.event?.thread_ts && e.event?.thread_ts !== e.event?.ts);\nconst isEdit = subtype === 'message_changed';\nconst isBotMessage = subtype === 'bot_message' || hasBotId;\nconst ignoredUser = ignoreUsers.includes(userId);\n\nif (isEdit || isBotMessage || ignoredUser || (ignoreThreadReplies && isThreadReply)) {\n  return [];\n}\n\nif (data.seen[eventId]) {\n  return [];\n}\n\ndata.seen[eventId] = now;\nreturn [{ json: { ...e, _event_key: eventId } }];"
