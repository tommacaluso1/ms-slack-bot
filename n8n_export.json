        "parameters": {
          "jsCode": "const e = $json.event || $json;\nconst text = (e.text || '').trim();\nconst fileName = e.files?.[0]?.name ? `\\nFile: ${e.files[0].name}` : '';\nconst attachmentText = Array.isArray(e.attachments) && e.attachments[0]?.text ? `\\nAttachment: ${e.attachments[0].text}` : '';\nconst enquiryText = `${text}${fileName}${attachmentText}`.trim();\n\nconst urgency = /(urgent|asap|outage|down|sev1|critical)/i.test(enquiryText) ? 'high' : (/(soon|today|issue|problem|blocked)/i.test(enquiryText) ? 'medium' : 'low');\nconst confidence = enquiryText.length > 15 ? 0.78 : 0.45;\nconst intent = /(invoice|billing|payment|refund)/i.test(enquiryText) ? 'billing' : (/(error|bug|broken|cannot|can't|login|access|vpn|password|it)/i.test(enquiryText) ? 'it_support' : (/(complaint|unhappy|frustrated)/i.test(enquiryText) ? 'complaint' : 'new_enquiry'));\nconst tags = ['slack', 'enquiry', intent];\nif (confidence < 0.5) tags.push('needs_triage');\n\nconst channel = e.channel || '';\nconst ts = e.ts || '';\nconst permalink = `https://slack.com/archives/${channel}/p${String(ts).replace('.', '')}`;\n\nconst classification = {\n  intent: confidence < 0.5 ? 'other' : intent,\n  category: confidence < 0.5 ? 'triage' : intent.replace('_', ' '),\n  summary: enquiryText.split('\\n')[0].slice(0, 120) || 'Slack enquiry',\n  details: enquiryText ? `- Reported in Slack\\n- Raw: ${enquiryText.slice(0, 1500)}` : '- Reported in Slack',\n  urgency,\n  confidence,\n  suggested_tags: tags,\n  requester_email: '',\n  requester_name: ''\n};\n\nreturn [{ json: {\n  enquiry_text: enquiryText,\n  requester_slack_user_id: e.user || '',\n  channel_id: channel,\n  ts,\n  permalink,\n  classification\n}}];"
