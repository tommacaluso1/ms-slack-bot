          "jsCode": "const data = getWorkflowStaticData('global');\nif (!data.seen) data.seen = {};\nconst now = Date.now();\nconst ttlMs = 1000 * 60 * 60 * 24 * 60;\nfor (const [k, v] of Object.entries(data.seen)) {\n  if (!v?.t || now - v.t > ttlMs) delete data.seen[k];\n}\nconst key = `${$json.ticket_id}:${$json.updated_at || 'na'}`;\nif (data.seen[key]) return [];\ndata.seen[key] = { t: now };\nreturn [{ json: { ...$json, _dedupe_key: key } }];"
