      {
        "parameters": {
          "jsCode": "const txt = $json.redacted_text || '';\nconst subj = ($json.ticket.subject || 'Untitled').replace(/\\s+/g, ' ').trim();\nconst confidence = txt.length > 100 ? 0.82 : 0.55;\nconst steps = [];\nif (/password|login|access/i.test(txt)) {\n  steps.push('Verify account status and reset credentials if needed.');\n  steps.push('Clear cached credentials and retry sign in.');\n}\nif (/error|failed|exception|timeout/i.test(txt)) {\n  steps.push('Capture exact error and timestamp from logs.');\n  steps.push('Apply known fix or rollback recent change.');\n}\nif (!steps.length) steps.push('Review ticket history and apply documented troubleshooting steps.');\n\nconst kb = {\n  should_create_kb: confidence >= Number($env.KB_MIN_CONFIDENCE || 0.75),\n  confidence,\n  kb_title: `How to resolve: ${subj}`.slice(0, 200),\n  kb_problem: txt.slice(0, 400),\n  kb_environment: 'Freshdesk / Slack intake',\n  kb_steps: steps,\n  kb_resolution: 'Issue resolved using validated support workflow and corrective actions.',\n  kb_keywords: Array.from(new Set([...(($json.ticket.tags)||[]), 'support', 'resolved'])).slice(0, 10),\n  kb_folder_name: ($json.ticket.type || 'General').toString().slice(0, 60),\n  kb_article_tags: Array.from(new Set([...(($json.ticket.tags)||[]), 'draft', 'internal'])).slice(0, 15)\n};\nreturn [{ json: { ...$json, kb } }];"
        },
